    {
      "start_ms": 142879,
      "end_ms": 147280,
      "start": "00:02:22.879",
      "end": "00:02:27.280",
      "text": "in between fights. The vision here is"
    },
    {
      "start_ms": 145200,
      "end_ms": 149520,
      "start": "00:02:25.200",
      "end": "00:02:29.520",
      "text": "absolutely off the charts. Everybody can"
    },
    {
      "start_ms": 147280,
      "end_ms": 151520,
      "start": "00:02:27.280",
      "end": "00:02:31.520",
      "text": "see to the spawn door and past it. What"
