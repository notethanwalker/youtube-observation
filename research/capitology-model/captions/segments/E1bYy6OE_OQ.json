    {
      "start_ms": 166239,
      "end_ms": 169920,
      "start": "00:02:46.239",
      "end": "00:02:49.920",
      "text": "fight here, it's an oppressive setup. If"
    },
    {
      "start_ms": 168319,
      "end_ms": 171680,
      "start": "00:02:48.319",
      "end": "00:02:51.680",
      "text": "they don't, they can go behind this"
    },
    {
      "start_ms": 169920,
      "end_ms": 173440,
      "start": "00:02:49.920",
      "end": "00:02:53.440",
      "text": "corner. Nobody on Nightmare knows where"
    },
    {
      "start_ms": 171680,
      "end_ms": 175440,
      "start": "00:02:51.680",
      "end": "00:02:55.440",
      "text": "they are, but everybody on GK knows"
    },
    {
      "start_ms": 173440,
      "end_ms": 177200,
      "start": "00:02:53.440",
      "end": "00:02:57.200",
      "text": "where Nightmare is. If we watch from"
    },
    {
      "start_ms": 175440,
      "end_ms": 179200,
      "start": "00:02:55.440",
      "end": "00:02:59.200",
      "text": "here, you'll see GK decides not to fight"
    },
    {
      "start_ms": 177200,
      "end_ms": 180480,
      "start": "00:02:57.200",
      "end": "00:03:00.480",
      "text": "here, and they go behind the corner. If"
    },
    {
      "start_ms": 179200,
      "end_ms": 183200,
      "start": "00:02:59.200",
      "end": "00:03:03.200",
      "text": "you watch from the Nightmare players"
    },
    {
      "start_ms": 180480,
      "end_ms": 186319,
      "start": "00:03:00.480",
      "end": "00:03:06.319",
      "text": "POVs, it's really difficult. Painkiller"
