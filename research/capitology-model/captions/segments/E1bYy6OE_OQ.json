    {
      "start_ms": 120240,
      "end_ms": 123439,
      "start": "00:02:00.240",
      "end": "00:02:03.439",
      "text": "actually the difference maker. The"
    },
    {
      "start_ms": 121920,
      "end_ms": 125439,
      "start": "00:02:01.920",
      "end": "00:02:05.439",
