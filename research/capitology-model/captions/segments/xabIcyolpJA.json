    {
      "start_ms": 70080,
      "end_ms": 75159,
      "start": "00:01:10.080",
      "end": "00:01:15.159",
      "text": "in this fight, Rocket quickly finds"
    },
    {
      "start_ms": 71600,
      "end_ms": 75159,
      "start": "00:01:11.600",
      "end": "00:01:15.159",
