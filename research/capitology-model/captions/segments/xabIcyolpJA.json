    },
    {
      "start_ms": 114560,
      "end_ms": 120439,
      "start": "00:01:54.560",
      "end": "00:02:00.439",
      "text": "is my first chance to kill someone, but"
    },
    {
      "start_ms": 116240,
      "end_ms": 120439,
      "start": "00:01:56.240",
      "end": "00:02:00.439",
      "text": "if I don't, I need to move quickly."
    },
    {
      "start_ms": 121920,
      "end_ms": 126079,
      "start": "00:02:01.920",
      "end": "00:02:06.079",
      "text": "Moving away from a spot before you get"
    },
    {
      "start_ms": 123600,
      "end_ms": 128080,
      "start": "00:02:03.600",
      "end": "00:02:08.080",
      "text": "forced out is an important detail here."
    },
    {
      "start_ms": 126079,
      "end_ms": 129759,
      "start": "00:02:06.079",
      "end": "00:02:09.759",
